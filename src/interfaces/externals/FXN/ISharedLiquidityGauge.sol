pragma solidity ^0.8.24;
interface ISharedLiquidityGauge {
    function DEFAULT_ADMIN_ROLE() external view returns (bytes32);
    function DOMAIN_SEPARATOR() external view returns (bytes32);
    function REWARD_MANAGER_ROLE() external view returns (bytes32);
    function acceptSharedVote(address _newOwner) external;
    function allowance(address owner, address spender) external view returns (uint256);
    function approve(address spender, uint256 amount) external returns (bool);
    function balanceOf(address account) external view returns (uint256);
    function checkpoint(address _account) external;
    function claim(address _account) external;
    function claim(address _account, address _receiver) external;
    function claim() external;
    function claimHistorical(address[] memory _tokens) external;
    function claimHistorical(address _account, address[] memory _tokens) external;
    function claimable(address _account, address _token) external view returns (uint256);
    function claimed(address _account, address _token) external view returns (uint256);
    function controller() external view returns (address);
    function decimals() external view returns (uint8);
    function decreaseAllowance(address spender, uint256 subtractedValue) external returns (bool);
    function deposit(uint256 _amount, address _receiver) external;
    function deposit(uint256 _amount, address _receiver, bool _manage) external;
    function deposit(uint256 _amount) external;
    function depositReward(address _token, uint256 _amount) external;
    function disableGauge() external;
    function distributors(address) external view returns (address);
    function eip712Domain()
        external
        view
        returns (bytes1 fields, string memory name, string memory version, uint256 chainId, address verifyingContract, bytes32 salt, uint256[] memory extensions);
    function getActiveRewardTokens() external view returns (address[] memory _rewardTokens);
    function getHistoricalRewardTokens() external view returns (address[] memory _rewardTokens);
    function getRoleAdmin(bytes32 role) external view returns (bytes32);
    function getStakerVoteOwner(address _account) external view returns (address);
    function governanceToken() external view returns (address);
    function grantRole(bytes32 role, address account) external;
    function hasRole(bytes32 role, address account) external view returns (bool);
    function increaseAllowance(address spender, uint256 addedValue) external returns (bool);
    function inflationParams() external view returns (uint192 rate, uint64 futureEpochTime);
    function initialize(address _stakingToken) external;
    function integrate_fraction(address account) external view returns (uint256);
    function isActive() external view returns (bool);
    function isStakerAllowed(address, address) external view returns (bool);
    function kick(address _account) external;
    function manager() external view returns (address);
    function minter() external view returns (address);
    function name() external view returns (string memory);
    function nonces(address owner) external view returns (uint256);
    function numAcceptedStakers(address) external view returns (uint256);
    function pendingRewards(address _token) external view returns (uint256, uint256);
    function periodLength() external view returns (uint40);
    function permit(address owner, address spender, uint256 value, uint256 deadline, uint8 v, bytes32 r, bytes32 s) external;
    function registerRewardToken(address _token, address _distributor) external;
    function rejectSharedVote() external;
    function renounceRole(bytes32 role, address account) external;
    function revokeRole(bytes32 role, address account) external;
    function rewardData(address) external view returns (uint96 queued, uint80 rate, uint40 lastUpdate, uint40 finishAt);
    function rewardReceiver(address) external view returns (address);
    function rewardSnapshot(address) external view returns (uint64 timestamp, uint192 integral);
    function setRewardReceiver(address _newReceiver) external;
    function sharedBalanceOf(address) external view returns (uint256);
    function snapshot() external view returns (uint64 timestamp, uint192 integral);
    function stakingToken() external view returns (address);
    function supportsInterface(bytes4 interfaceId) external view returns (bool);
    function symbol() external view returns (string memory);
    function toggleVoteSharing(address _staker) external;
    function totalSupply() external view returns (uint256);
    function transfer(address to, uint256 amount) external returns (bool);
    function transferFrom(address from, address to, uint256 amount) external returns (bool);
    function unregisterRewardToken(address _token) external;
    function updateLiquidityManager(address _newManager) external;
    function updateRewardDistributor(address _token, address _newDistributor) external;
    function user_checkpoint(address _account) external returns (bool);
    function ve() external view returns (address);
    function veProxy() external view returns (address);
    function withdraw(uint256 _amount, address _receiver) external;
    function withdraw(uint256 _amount) external;
    function workingBalanceOf(address) external view returns (uint256);
    function workingSupply() external view returns (uint256);
}
