pragma solidity ^0.8.24;
interface IsDOLA {
    function DOMAIN_SEPARATOR() external view returns (bytes32);
    function MAX_ASSETS() external view returns (uint256);
    function MIN_SHARES() external view returns (uint256);
    function acceptGov() external;
    function allowance(address, address) external view returns (uint256);
    function approve(address spender, uint256 amount) external returns (bool);
    function asset() external view returns (address);
    function balanceOf(address) external view returns (uint256);
    function buyDBR(uint256 exactDolaIn, uint256 exactDbrOut, address to) external;
    function convertToAssets(uint256 shares) external view returns (uint256);
    function convertToShares(uint256 assets) external view returns (uint256);
    function dbr() external view returns (address);
    function decimals() external view returns (uint8);
    function deposit(uint256 assets, address receiver) external returns (uint256 shares);
    function getDbrReserve() external view returns (uint256);
    function getDolaReserve() external view returns (uint256);
    function getDolaReserve(uint256 dbrReserve) external view returns (uint256);
    function getK() external view returns (uint256);
    function gov() external view returns (address);
    function lastKUpdate() external view returns (uint256);
    function maxDeposit(address) external view returns (uint256);
    function maxMint(address) external view returns (uint256);
    function maxRedeem(address owner) external view returns (uint256);
    function maxWithdraw(address owner) external view returns (uint256);
    function mint(uint256 shares, address receiver) external returns (uint256 assets);
    function name() external view returns (string memory);
    function nonces(address) external view returns (uint256);
    function operator() external view returns (address);
    function pendingGov() external view returns (address);
    function permit(address owner, address spender, uint256 value, uint256 deadline, uint8 v, bytes32 r, bytes32 s) external;
    function prevK() external view returns (uint256);
    function previewDeposit(uint256 assets) external view returns (uint256);
    function previewMint(uint256 shares) external view returns (uint256);
    function previewRedeem(uint256 shares) external view returns (uint256);
    function previewWithdraw(uint256 assets) external view returns (uint256);
    function reapprove() external;
    function redeem(uint256 shares, address receiver, address owner) external returns (uint256 assets);
    function savings() external view returns (address);
    function setOperator(address _operator) external;
    function setPendingGov(address _gov) external;
    function setTargetK(uint256 _K) external;
    function sweep(address token, uint256 amount, address to) external;
    function symbol() external view returns (string memory);
    function targetK() external view returns (uint256);
    function totalAssets() external view returns (uint256);
    function totalSupply() external view returns (uint256);
    function transfer(address to, uint256 amount) external returns (bool);
    function transferFrom(address from, address to, uint256 amount) external returns (bool);
    function weeklyRevenue(uint256) external view returns (uint256);
    function withdraw(uint256 assets, address receiver, address owner) external returns (uint256 shares);
}
