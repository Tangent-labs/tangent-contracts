{
  "name": "tangent-contracts",
  "version": "1.0.0",
  "description": "## Install dependencies",
  "main": "index.js",
  "type": "commonjs",
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "hh-node": "npx hardhat node --hostname 0.0.0.0 ",
    "dapp-setup": "npx hardhat run js-scripts/hardhat/dappSetup/run-setup-booster.ts --network localhost",
    "deploy-tgUSD": "npx hardhat run js-scripts/hardhat/tgUSD/scripts/deployTgUSD.ts --network localhost",
    "flatten-contracts": "npx ts-node js-scripts/utils/flattenContracts.ts",
    "verify-contracts-blockscout": "npx ts-node js-scripts/hardhat/tgUSD/blockscout/verify-contracts.ts",
    "distribute-rewards-rsTan": "npx hardhat run js-scripts/hardhat/tgUSD/actions/distributeRewardsRsTan.ts --network localhost",
    "distribute-rewards-markets": "npx hardhat run js-scripts/hardhat/tgUSD/actions/distributeRewardsMarkets.ts --network localhost",
    "deposit-markets-tgUSD": "npx hardhat run js-scripts/hardhat/tgUSD/scripts/deposit.ts --network localhost",
    "borrow-markets-tgUSD": "npx hardhat run js-scripts/hardhat/tgUSD/scripts/borrow.ts --network localhost",
    "swap-curve": "npx hardhat run js-scripts/hardhat/tgUSD/scripts/swap.ts --network localhost",
    "full-tgUSD": "npm run deploy-tgUSD &  npm run distribute-rewards-tgUSD & npm run deposit-markets-tgUSD  & npm run borrow-markets-tgUSD",
    "time-travel": "npx hardhat run js-scripts/hardhat/tgUSD/actions/time-travel.ts --network localhost",
    "liquidation-context": "npx hardhat run js-scripts/hardhat/tgUSD/scripts/liquidationSetUp.ts --network localhost",
    "booster-setup": "npx hardhat run js-scripts/hardhat/dappSetup/run-setup-booster.ts --network localhost",
    "generate-routes": "npx hardhat run  js-scripts/hardhat/tgUSD/routing/Curve/generateCurveRoutes.ts --network localhost",
    "hydrate-routes": "npx hardhat run  js-scripts/hardhat/tgUSD/routing/Curve/hydrateFinalRoutes.ts --network localhost",
    "test-curve-routes": "npx hardhat run  js-scripts/hardhat/tgUSD/routing/Curve/testFinalRoutes.ts --network localhost",
    "coverage": "forge coverage --report lcov && genhtml lcov.info --branch-coverage --output-dir coverage"
  },
  "author": "Trottoir",
  "license": "ISC",
  "devDependencies": {
    "@layerzerolabs/lz-definitions": "^3.0.44",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-foundry": "^1.1.2",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.9",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomiclabs/hardhat-vyper": "^3.0.8",
    "@types/pg": "^8.11.11",
    "chai": "4.3.7",
    "defi-resources": "https://github.com/Tangent-labs/defi-resources.git#main",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.4",
    "hardhat": "^2.22.17",
    "decimal.js": "^10.5.0",
    "hardhat-contract-sizer": "^2.10.0"
  }
}
