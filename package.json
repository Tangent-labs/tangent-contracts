{
  "name": "tangent-contracts",
  "version": "1.0.0",
  "description": "## Install dependencies",
  "main": "index.js",
  "type": "commonjs",
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "hh-node": "npx hardhat node --fork https://eth-mainnet.g.alchemy.com/v2/hDva-MsYmcDn3GhDTeMYHq4iKLiT1NYy",
    "dapp-setup": "npx hardhat run js-scripts/hardhat/dappSetup/run-setup-booster.ts --network localhost",
    "build": "forge build --skip ./src/LendSplitter/* ./test/lendSplitter/*",
    "deploy-tgUSD": "npx hardhat run js-scripts/hardhat/tgUSD/_deploy.ts --network localhost",
    "distribute-rewards-tgUSD": "npx hardhat run js-scripts/hardhat/tgUSD/actions/distributeRewards.ts --network localhost",
    "stake-tgUSD": "npx hardhat run js-scripts/hardhat/tgUSD/actions/stake.ts --network localhost",
    "time-travel": "npx hardhat run js-scripts/hardhat/tgUSD/actions/time-travel.ts --network localhost"
  },
  "author": "Trottoir",
  "license": "ISC",
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-foundry": "^1.1.2",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.9",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "chai": "4.3.7",
    "convergence-defi-tools": "https://github.com/Convergence-fi/convergence-defi-tools.git#main",
    "ethers": "^6.13.4"
  },
  "dependencies": {
    "hardhat": "^2.22.17"
  }
}
