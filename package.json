{
  "name": "tangent-contracts",
  "version": "1.0.0",
  "description": "## Install dependencies",
  "main": "index.js",
  "type": "commonjs",
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "hh-node": "npx hardhat node --hostname 0.0.0.0",
    "anvil-node": "anvil --fork-url https://eth-mainnet.g.alchemy.com/v2/zCrDEsqvlSdKaF_Tv0q4Q --chain-id 31337",
    "deploy:usg-local": "npx hardhat run js-scripts/hardhat/USG/scripts/deployMainnetAddresses.ts --network localhost",
    "deploy:usg-staging": "npx hardhat run js-scripts/hardhat/USG/scripts/deployMainnetAddresses.ts --network staging",
    "full-USG": "npm run deploy-USG &  npm run distribute-rewards-USG & npm run deposit-markets-USG  & npm run borrow-markets-USG",
    "verify-contracts-blockscout": "npx hardhat run js-scripts/hardhat/USG/blockscout/verify-contracts.ts --network localhost",
    "booster-setup": "npx hardhat run js-scripts/hardhat/dappSetup/run-setup-booster.ts --network localhost",
    "liquidation-context": "npx hardhat run js-scripts/hardhat/USG/scripts/liquidationSetUp.ts --network localhost",
    "liquidation-context-chaos": "npx hardhat run js-scripts/hardhat/USG/scripts/liquidationSetUpChaos.ts --network localhost",
    "liquidation-context-test": "npx hardhat run js-scripts/hardhat/USG/scripts/liquidationTestRun.ts --network localhost",
    "liquidation-check": "npx hardhat run js-scripts/hardhat/USG/scripts/LiquidationCheck.ts --network localhost",
    "saving-account-context": "npx hardhat run js-scripts/hardhat/USG/scripts/savingaccountSetUp.ts --network localhost",
    "routing:generate-routes": "npx hardhat run  js-scripts/hardhat/USG/routing/Curve/generateCurveRoutes.ts --network localhost",
    "routing:hydrate-routes": "npx hardhat run  js-scripts/hardhat/USG/routing/Curve/hydrateFinalRoutes.ts --network localhost",
    "routing:test-curve-routes": "npx hardhat run js-scripts/hardhat/USG/routing/Curve/testFinalRoutes.ts --network localhost",
    "action:distribute-rewards-vsTan": "npx hardhat run js-scripts/hardhat/USG/actions/distributeRewardsVsTan.ts --network localhost",
    "action:distribute-rewards-markets": "npx hardhat run js-scripts/hardhat/USG/actions/distributeRewardsMarkets.ts --network localhost",
    "action:deposit-markets-USG": "npx hardhat run js-scripts/hardhat/USG/scripts/deposit.ts --network localhost",
    "action:borrow-markets-USG": "npx hardhat run js-scripts/hardhat/USG/scripts/borrow.ts --network localhost",
    "action:time-travel": "npx hardhat run js-scripts/hardhat/USG/actions/time-travel.ts --network localhost",
    "action:distribute-usg": "npx hardhat run js-scripts/hardhat/USG/scripts/distributeUSG.ts --network localhost",
    "liquidboost:dapp-setup": "npx hardhat run js-scripts/hardhat/dappSetup/run-setup-booster.ts --network localhost",
    "points:generate-context": "npx hardhat run js-scripts/hardhat/USG/scripts/userActionGenerator.ts",
    "points:run-context-local": "npx hardhat run js-scripts/hardhat/USG/scripts/generated-actions.ts --network localhost",
    "points:run-context-staging": "npx hardhat run js-scripts/hardhat/USG/scripts/generated-actions.ts --network staging",
    "test:coverage": "forge coverage --report lcov --no-match-coverage '(test|src/chainview|src/Upgradeable|src/lib|src/mock)' && genhtml lcov.info --branch-coverage --output-dir coverage --rc derive_function_end_line=0"
  },
  "author": "Trottoir",
  "license": "ISC",
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "3.1.0",
    "@nomicfoundation/hardhat-foundry": "1.1.2",
    "@nomicfoundation/hardhat-ignition-ethers": "0.15.9",
    "@nomicfoundation/hardhat-toolbox": "5.0.0",
    "@nomiclabs/hardhat-vyper": "3.1.0",
    "@tangent/defi-resources": "github:Tangent-labs/defi-resources#main",
    "@tenderly/hardhat-tenderly": "2.5.2",
    "@types/pg": "8.11.11",
    "chai": "4.3.7",
    "decimal.js": "10.5.0",
    "dotenv": "16.4.7",
    "ethers": "6.14.0",
    "hardhat": "2.26.0",
    "hardhat-contract-sizer": "2.10.0",
    "pg": "8.16.0"
  }
}